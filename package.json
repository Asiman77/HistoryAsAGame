{
  "name": "tarixin-icinde",
  "version": "0.1.0",
  "private": true,
  "description": "Tarixin İçində — Azərbaycan tarixi şəxsiyyətlərinin interaktiv həyat simulyasiyası",
  "scripts": {
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs && tsx scripts/build-territories.ts",
    "dev": "next dev",
    "build": "npm run validate:data && next build && node scripts/flatten-segments.mjs",
    "start": "serve out -l 3000",
    "validate:data": "tsx scripts/validate-data.ts",
    "schema:export": "tsx scripts/export-json-schema.ts",
    "schema:check": "tsx scripts/export-json-schema.ts --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prebuild": "node scripts/copy-maplibre-worker.mjs && tsx scripts/build-territories.ts",
    "build:territories": "tsx scripts/build-territories.ts",
    "generate:audio": "tsx scripts/generate-audio.ts",
    "api:types": "openapi-typescript shared/openapi/public.json -o src/data/api/openapi.ts",
    "content:pull": "tsx scripts/pull-content.ts",
    "build:api": "node scripts/copy-maplibre-worker.mjs && tsx scripts/pull-content.ts && next build && node scripts/flatten-segments.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "stories:shots": "tsx scripts/story-screenshots.ts",
    "pages:shots": "tsx scripts/page-screenshots.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.2",
    "@turf/turf": "^7.4.0",
    "howler": "^2.2.4",
    "lucide-react": "^1.77.0",
    "maplibre-gl": "^6.19.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "next-intl": "^4.15.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@breezystack/lamejs": "^1.2.7",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/nextjs-vite": "^10.6.8",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "serve": "^14.2.8",
    "storybook": "^10.6.8",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher": false,
    "@swc/core": false
  }
}
