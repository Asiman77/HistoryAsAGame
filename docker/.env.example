# Copy to docker/.env and fill in. docker/.env is git-ignored; never commit real values.

# PostgreSQL
POSTGRES_DB=tarix
POSTGRES_USER=tarix
POSTGRES_PASSWORD=

# S3-compatible object storage (SeaweedFS locally, see docs/adr/0008)
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Host ports
BACKEND_PORT=8080
DB_PORT=5432
