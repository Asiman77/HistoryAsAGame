# Copy to docker/.env and fill in. docker/.env is git-ignored; never commit real values.

# PostgreSQL
POSTGRES_DB=tarix
POSTGRES_USER=tarix
POSTGRES_PASSWORD=

# S3-compatible object storage (SeaweedFS locally, see docs/adr/0008)
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Access tokens: Base64 HMAC key, at least 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=

# First ADMIN account, created on startup if it does not exist (password: 12+ characters).
# An existing account is never changed by these values.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Browser origins that may call the API, comma-separated, exact (scheme://host[:port], no *).
# Default: the Next.js dev server, http://localhost:3000.
CORS_ALLOWED_ORIGINS=

# Host ports
BACKEND_PORT=8080
DB_PORT=5432

# Media (docs/adr/0017). Where browsers reach the S3 port: presigned upload URLs sign this
# host, and uploaded files are read from MEDIA_PUBLIC_BASE_URL (a CDN in production).
S3_PUBLIC_ENDPOINT=http://localhost:8333
MEDIA_PUBLIC_BASE_URL=http://localhost:8333/media
