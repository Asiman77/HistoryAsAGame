{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarixin-icinde.az/schema/v1/TopicStepRef.schema.json",
  "x-schema-version": 1,
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "person",
        "conflict",
        "state"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "stepId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    }
  },
  "required": [
    "type",
    "id",
    "stepId"
  ]
}
