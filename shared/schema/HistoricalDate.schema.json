{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarixin-icinde.az/schema/v1/HistoricalDate.schema.json",
  "x-schema-version": 1,
  "type": "object",
  "properties": {
    "year": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "month": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31
    },
    "certainty": {
      "$ref": "https://tarixin-icinde.az/schema/v1/Certainty.schema.json"
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          },
          "note": {
            "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
          },
          "source": {
            "$ref": "https://tarixin-icinde.az/schema/v1/Source.schema.json"
          }
        },
        "required": [
          "year",
          "note"
        ]
      }
    },
    "note": {
      "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
    }
  },
  "required": [
    "year",
    "certainty"
  ]
}
