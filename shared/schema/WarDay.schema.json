{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarixin-icinde.az/schema/v1/WarDay.schema.json",
  "x-schema-version": 1,
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "date": {
      "$ref": "https://tarixin-icinde.az/schema/v1/HistoricalDate.schema.json"
    },
    "dayNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "kind": {
      "type": "string",
      "enum": [
        "operation",
        "liberation",
        "memorial",
        "statement",
        "epilogue"
      ]
    },
    "title": {
      "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
    },
    "summary": {
      "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
    },
    "mood": {
      "$ref": "https://tarixin-icinde.az/schema/v1/Mood.schema.json"
    },
    "location": {
      "$ref": "https://tarixin-icinde.az/schema/v1/Location.schema.json"
    },
    "zoom": {
      "type": "number",
      "minimum": 2.5,
      "maximum": 10
    },
    "territorySnapshotId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "liberated": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "extraLiberated": {
      "type": "object",
      "properties": {
        "villages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "towns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "heights": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "commanders": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "fallenHeroes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "officialStatement": {
      "type": "object",
      "properties": {
        "title": {
          "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
        },
        "url": {
          "type": "string",
          "format": "iri"
        },
        "date": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "url",
        "date"
      ]
    },
    "related": {
      "type": "array",
      "items": {
        "$ref": "https://tarixin-icinde.az/schema/v1/EntityRef.schema.json"
      }
    },
    "themeId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "claimType": {
      "$ref": "https://tarixin-icinde.az/schema/v1/ClaimType.schema.json"
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "https://tarixin-icinde.az/schema/v1/Claim.schema.json"
      }
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "https://tarixin-icinde.az/schema/v1/Source.schema.json"
      }
    },
    "quiz": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "$ref": "https://tarixin-icinde.az/schema/v1/QuizQuestion.schema.json"
      }
    }
  },
  "required": [
    "id",
    "order",
    "date",
    "kind",
    "title",
    "summary",
    "mood",
    "location",
    "sources"
  ]
}
