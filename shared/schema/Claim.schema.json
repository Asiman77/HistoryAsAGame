{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarixin-icinde.az/schema/v1/Claim.schema.json",
  "x-schema-version": 1,
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "claimType": {
      "$ref": "https://tarixin-icinde.az/schema/v1/ClaimType.schema.json"
    },
    "text": {
      "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
    },
    "why": {
      "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "https://tarixin-icinde.az/schema/v1/Source.schema.json"
      }
    },
    "firstRecorded": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "https://tarixin-icinde.az/schema/v1/Source.schema.json"
        },
        "year": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "note": {
          "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
        }
      },
      "required": [
        "source"
      ]
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "https://tarixin-icinde.az/schema/v1/Source.schema.json"
            }
          }
        },
        "required": [
          "text",
          "sources"
        ]
      }
    }
  },
  "required": [
    "id",
    "claimType",
    "text",
    "sources"
  ]
}
