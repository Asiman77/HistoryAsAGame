{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarixin-icinde.az/schema/v1/StateStep.schema.json",
  "x-schema-version": 1,
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "date": {
      "$ref": "https://tarixin-icinde.az/schema/v1/HistoricalDate.schema.json"
    },
    "title": {
      "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
    },
    "summary": {
      "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
    },
    "mood": {
      "$ref": "https://tarixin-icinde.az/schema/v1/Mood.schema.json"
    },
    "location": {
      "$ref": "https://tarixin-icinde.az/schema/v1/Location.schema.json"
    },
    "zoom": {
      "type": "number",
      "minimum": 2.5,
      "maximum": 9
    },
    "territorySnapshotId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "capitalId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "polityId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
          }
        },
        "required": [
          "date",
          "text"
        ]
      }
    },
    "keyFacts": {
      "type": "object",
      "properties": {
        "area": {
          "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
        },
        "population": {
          "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
        },
        "army": {
          "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
        },
        "economy": {
          "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
        },
        "religion": {
          "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
        },
        "languages": {
          "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
        }
      }
    },
    "related": {
      "type": "array",
      "items": {
        "$ref": "https://tarixin-icinde.az/schema/v1/EntityRef.schema.json"
      }
    },
    "themeId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "claimType": {
      "$ref": "https://tarixin-icinde.az/schema/v1/ClaimType.schema.json"
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "https://tarixin-icinde.az/schema/v1/Claim.schema.json"
      }
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "https://tarixin-icinde.az/schema/v1/Source.schema.json"
      }
    },
    "quiz": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "$ref": "https://tarixin-icinde.az/schema/v1/QuizQuestion.schema.json"
      }
    }
  },
  "required": [
    "id",
    "order",
    "date",
    "title",
    "summary",
    "mood",
    "location",
    "sources"
  ]
}
