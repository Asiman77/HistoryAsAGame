{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarixin-icinde.az/schema/v1/CurriculumGrade.schema.json",
  "x-schema-version": 1,
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "grade": {
      "type": "integer",
      "minimum": 1,
      "maximum": 11
    },
    "title": {
      "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
    },
    "textbook": {
      "$ref": "https://tarixin-icinde.az/schema/v1/Textbook.schema.json"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
          },
          "topics": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "https://tarixin-icinde.az/schema/v1/CurriculumTopic.schema.json"
            }
          }
        },
        "required": [
          "id",
          "title",
          "topics"
        ]
      }
    },
    "sample": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "subject",
    "grade",
    "title",
    "sections"
  ]
}
