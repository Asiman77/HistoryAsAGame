{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarixin-icinde.az/schema/v1/LifeEvent.schema.json",
  "x-schema-version": 1,
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "personId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "date": {
      "$ref": "https://tarixin-icinde.az/schema/v1/HistoricalDate.schema.json"
    },
    "type": {
      "type": "string",
      "enum": [
        "birth",
        "childhood",
        "education",
        "journey",
        "battle",
        "coronation",
        "marriage",
        "diplomacy",
        "culture",
        "exile",
        "death"
      ]
    },
    "mood": {
      "$ref": "https://tarixin-icinde.az/schema/v1/Mood.schema.json"
    },
    "location": {
      "$ref": "https://tarixin-icinde.az/schema/v1/Location.schema.json"
    },
    "fromLocation": {
      "$ref": "https://tarixin-icinde.az/schema/v1/Location.schema.json"
    },
    "route": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    },
    "territorySnapshotId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
    },
    "factualSummary": {
      "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
    },
    "narrative": {
      "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
    },
    "outcome": {
      "$ref": "https://tarixin-icinde.az/schema/v1/BattleOutcome.schema.json"
    },
    "template": {
      "$ref": "https://tarixin-icinde.az/schema/v1/StepTemplate.schema.json"
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "https://tarixin-icinde.az/schema/v1/Source.schema.json"
      }
    },
    "choice": {
      "$ref": "https://tarixin-icinde.az/schema/v1/Choice.schema.json"
    },
    "quiz": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "$ref": "https://tarixin-icinde.az/schema/v1/QuizQuestion.schema.json"
      }
    },
    "narrationAudio": {
      "$ref": "https://tarixin-icinde.az/schema/v1/NarrationAudio.schema.json"
    },
    "primarySource": {
      "$ref": "https://tarixin-icinde.az/schema/v1/PrimaryExcerpt.schema.json"
    },
    "related": {
      "type": "array",
      "items": {
        "$ref": "https://tarixin-icinde.az/schema/v1/EntityRef.schema.json"
      }
    },
    "themeId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "claimType": {
      "$ref": "https://tarixin-icinde.az/schema/v1/ClaimType.schema.json"
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "https://tarixin-icinde.az/schema/v1/Claim.schema.json"
      }
    }
  },
  "required": [
    "id",
    "personId",
    "order",
    "date",
    "type",
    "mood",
    "location",
    "title",
    "factualSummary",
    "narrative",
    "sources"
  ]
}
