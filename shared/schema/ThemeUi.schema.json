{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarixin-icinde.az/schema/v1/ThemeUi.schema.json",
  "x-schema-version": 1,
  "type": "object",
  "properties": {
    "bg": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "bgRaised": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "bgPanel": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "accent": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "accentInk": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "secondary": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      }
    },
    "text": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "secondary": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "eyebrow": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    }
  },
  "required": [
    "bg",
    "accent"
  ]
}
