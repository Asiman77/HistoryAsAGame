{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarixin-icinde.az/schema/v1/PlannedFile.schema.json",
  "x-schema-version": 1,
  "type": "object",
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "person",
              "conflict",
              "battle",
              "state",
              "place",
              "ruler"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
          },
          "description": {
            "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
          },
          "years": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "id",
          "title"
        ]
      }
    }
  },
  "required": [
    "entities"
  ]
}
