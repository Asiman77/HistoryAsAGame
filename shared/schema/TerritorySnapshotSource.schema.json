{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarixin-icinde.az/schema/v1/TerritorySnapshotSource.schema.json",
  "x-schema-version": 1,
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "year": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "title": {
      "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
    },
    "certainty": {
      "$ref": "https://tarixin-icinde.az/schema/v1/Certainty.schema.json"
    },
    "note": {
      "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
    },
    "polities": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "polityId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
          },
          "regions": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "iso": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "capitalId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "vassalOf": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "labelAt": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "polityId"
        ]
      }
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "https://tarixin-icinde.az/schema/v1/Source.schema.json"
      }
    }
  },
  "required": [
    "id",
    "year",
    "title",
    "certainty",
    "polities",
    "sources"
  ]
}
