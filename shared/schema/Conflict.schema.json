{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarixin-icinde.az/schema/v1/Conflict.schema.json",
  "x-schema-version": 1,
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
    },
    "heading": {
      "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
    },
    "years": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
    },
    "legacy": {
      "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
    },
    "finalNotes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
          },
          "text": {
            "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "https://tarixin-icinde.az/schema/v1/Source.schema.json"
            }
          }
        },
        "required": [
          "title",
          "text",
          "sources"
        ]
      }
    },
    "introDate": {
      "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
    },
    "eraIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "themeId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "https://tarixin-icinde.az/schema/v1/Source.schema.json"
      }
    }
  },
  "required": [
    "id",
    "name",
    "heading",
    "years",
    "description",
    "legacy",
    "introDate",
    "eraIds",
    "sources"
  ]
}
