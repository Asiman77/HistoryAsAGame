{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarixin-icinde.az/schema/v1/Choice.schema.json",
  "x-schema-version": 1,
  "type": "object",
  "properties": {
    "prompt": {
      "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
    },
    "options": {
      "minItems": 2,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
          },
          "explanation": {
            "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
          }
        },
        "required": [
          "text",
          "explanation"
        ]
      }
    },
    "historicalOptionIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "why": {
      "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
    }
  },
  "required": [
    "prompt",
    "options",
    "historicalOptionIndex",
    "why"
  ]
}
