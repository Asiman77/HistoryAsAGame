{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarixin-icinde.az/schema/v1/LandFile.schema.json",
  "x-schema-version": 1,
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "Feature"
    },
    "properties": {
