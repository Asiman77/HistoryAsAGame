{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarixin-icinde.az/schema/v1/Source.schema.json",
  "x-schema-version": 1,
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "iri"
    },
    "type": {
      "type": "string",
      "enum": [
        "book",
        "article",
        "encyclopedia",
        "web",
        "primary",
        "dataset"
      ]
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "type"
  ]
}
