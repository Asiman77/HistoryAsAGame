{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarixin-icinde.az/schema/v1/Track.schema.json",
  "x-schema-version": 1,
  "type": "object",
  "properties": {
    "trackId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "$ref": "https://tarixin-icinde.az/schema/v1/LocalizedText.schema.json"
    },
    "performer": {
      "type": "string",
      "minLength": 1
    },
    "mood": {
      "$ref": "https://tarixin-icinde.az/schema/v1/Mood.schema.json"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "rightsHolder": {
      "type": "string",
      "minLength": 1
    },
    "permissionStatus": {
      "type": "string",
      "enum": [
        "pending",
        "granted"
      ]
    },
    "file": {
      "type": "string"
    }
  },
  "required": [
    "trackId",
    "title",
    "performer",
    "mood",
    "license",
    "rightsHolder",
    "permissionStatus"
  ]
}
